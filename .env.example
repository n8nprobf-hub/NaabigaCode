# NaabigaCode — exemple de configuration environnement
# Copiez ce fichier en .env et adaptez les valeurs.

# Provider et modèle d'inférence (optionnel — peut être dans config.yaml)
# NAABIGA_INFERENCE_PROVIDER=openai
# NAABIGA_INFERENCE_MODEL=gpt-4o

# URL du backend (par défaut http://127.0.0.1:8400)
# NAABIGA_BACKEND_URL=http://127.0.0.1:8400

# Répertoire home de Naabiga (par défaut ~/.naabiga)
# NAABIGA_HOME=~/.naabiga
